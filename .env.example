# Copy to .env in the project root and fill in real values. Never commit .env.

# Flask
FLASK_SECRET_KEY=change-me
FLASK_ENV=development
# CORS_ORIGINS=http://localhost:3000,https://bikes.example.com

# MySQL
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME_JCDECAUX=local_databasejcdecaux
DB_NAME_WEATHER=local_databaseopenweather
DB_NAME_AUTH=dublin_bikes_auth

# JCDecaux
JCDECAUX_API_KEY=
STATIONS_URI=https://api.jcdecaux.com/vls/v1/stations

# OpenWeatherMap
OPENWEATHER_API_KEY=
CITY=Dublin
LAT=53.3498
LON=-6.2603
CURRENT_WEATHER_URI=https://api.openweathermap.org/data/2.5/weather
FORECAST_WEATHER_URI=https://api.openweathermap.org/data/2.5/forecast

# Google Maps: browser key (referrer-restricted) + optional server key (IP-restricted)
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_SERVER_KEY=

# AI chatbot (Groq is the active backend)
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
